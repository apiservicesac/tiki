// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AgendaView > draws meetings, reminders and task alarms by day and time 1`] = `"<div class="island-tab-content"><div class="island-list agenda-list"><div class="island-group">Hoy</div><div class="island-row agenda-row agenda-meeting" title="ana@microsoft.test"><span class="agenda-time">09:00–09:30</span><span class="island-row-text">Daily de Altamira<small>Teams</small></span><span class="agenda-bell"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M4 10h16M9 3v4M15 3v4"></path></svg></span><button class="agenda-join" type="button">Unirse</button></div><div class="island-row agenda-row" data-task-id="8"><span class="agenda-time">11:00</span><button class="island-row-text" type="button" title="Editar tarea">Tomar agua<small>Cada día</small></button><span class="agenda-bell"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0"></path></svg></span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-group">Mañana</div><div class="island-row agenda-row" data-task-id="2"><span class="agenda-time">16:00</span><button class="island-row-text" type="button" title="Editar tarea">Mejora en el módulo de Ventas<small>Altamira · #ventas</small></button><span class="agenda-bell"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15zM10 20a2 2 0 0 0 4 0"></path></svg></span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div></div></div>"`;

exports[`TasksTabView > draws pending tasks grouped by project 1`] = `"<div class="island-list tasks-list"><div class="island-group tasks-group"><i class="tasks-group-dot" style="background: #17837D;"></i><span>Andeanvet</span><span class="tasks-group-count">3</span></div><div class="island-row" data-task-id="3"><span class="island-row-bar" style="background: #17837D;"></span><button class="island-row-text" type="button" title="Editar tarea">Acceso solo a análisis de facturas de Almendra<small>Andeanvet</small></button><span class="island-when island-when-critical">1 día de atraso</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-row" data-task-id="4"><span class="island-row-bar" style="background: #17837D;"></span><button class="island-row-text" type="button" title="Editar tarea">Saldo vacacional con solicitud rechazada<small>Andeanvet</small></button><span class="island-when island-when-normal">En curso</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-row" data-task-id="6"><span class="island-row-bar" style="background: #17837D;"></span><button class="island-row-text" type="button" title="Editar tarea">Confirmación de zonas del dashboard CxC<small>Andeanvet</small></button><span class="island-when island-when-waiting">esperando 1 día</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-group tasks-group"><i class="tasks-group-dot" style="background: #2F6BD8;"></i><span>Altamira</span><span class="tasks-group-count">2</span></div><div class="island-row" data-task-id="1"><span class="island-row-bar" style="background: #2F6BD8;"></span><button class="island-row-text" type="button" title="Editar tarea"><span class="island-priority island-priority-high" title="Alta">!</span>Tracking de formularios comerciales<small>Altamira</small></button><span class="island-when island-when-soon">mañana</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-row" data-task-id="2"><span class="island-row-bar" style="background: #2F6BD8;"></span><button class="island-row-text" type="button" title="Editar tarea">Mejora en el módulo de Ventas<small>Altamira · #ventas</small></button><span class="island-when island-when-soon">Vie 23</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-group tasks-group"><i class="tasks-group-dot" style="background: #C2410C;"></i><span>Vapestation</span><span class="tasks-group-count">1</span></div><div class="island-row" data-task-id="5"><span class="island-row-bar" style="background: #C2410C;"></span><button class="island-row-text" type="button" title="Editar tarea">Permisos de GitHub para retenciones de IGV<small>Vapestation</small></button><span class="island-when island-when-waiting">esperando 3 días</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div></div>"`;

exports[`TasksTabView > draws the delivered history 1`] = `"<div class="island-list tasks-list"><div class="island-row island-row-delivered" data-task-id="9"><span class="island-row-bar" style="background: #2F6BD8;"></span><button class="island-row-text" type="button" title="Editar tarea">Reporte de ventas de septiembre<small>Altamira · #ventas</small></button><span class="island-when island-when-done">hoy</span><span class="island-row-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span></div><div class="island-row island-row-delivered" data-task-id="8"><span class="island-row-bar"></span><button class="island-row-text" type="button" title="Editar tarea">Ajuste del acta CAPEX</button><span class="island-when island-when-done">ayer</span><span class="island-row-check"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span></div></div>"`;

exports[`TodayView > draws the focus, today's rows and the delivered link 1`] = `"<div class="island-tab-content"><p class="island-subtitle">miércoles 21 de octubre · 3 por atender</p><button class="island-focus" type="button" id="today-focus" data-task-id="3"><span class="island-focus-label">Ahora · Está atrasada</span><strong>Acceso solo a análisis de facturas de Almendra</strong><small>Andeanvet</small></button><button class="island-summary-prepare" type="button" id="prepare-brief">Resumir mi día</button><div class="island-list"><div class="island-group" data-section="due_soon">Vence pronto</div><div class="island-row" data-task-id="1"><span class="island-row-bar" style="background: #2F6BD8;"></span><button class="island-row-text" type="button" title="Editar tarea"><span class="island-priority island-priority-high" title="Alta">!</span>Tracking de formularios comerciales<small>Altamira</small></button><span class="island-when island-when-soon">mañana</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-row" data-task-id="2"><span class="island-row-bar" style="background: #2F6BD8;"></span><button class="island-row-text" type="button" title="Editar tarea">Mejora en el módulo de Ventas<small>Altamira · #ventas</small></button><span class="island-when island-when-soon">Vie 23</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div><div class="island-group" data-section="follow_up">Toca insistir</div><div class="island-row" data-task-id="5"><span class="island-row-bar" style="background: #C2410C;"></span><button class="island-row-text" type="button" title="Editar tarea">Permisos de GitHub para retenciones de IGV<small>Vapestation</small></button><span class="island-when island-when-waiting">esperando 3 días</span><button class="island-icon-button island-row-done" type="button" aria-label="Marcar como entregado" title="Marcar como entregado"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></button></div></div><button class="island-delivered-link" type="button" id="delivered-today">Entregado hoy (1)</button></div>"`;

exports[`TodayView > draws the latest reminder with its buttons 1`] = `"<div class="island-notice"><button class="island-notice-open" type="button" title="Ver el aviso"><strong>Tomar agua</strong><p>Son las 11:00</p></button><div class="island-notice-actions"><button class="settings-option" type="button" id="alert-done">Hecho</button><button class="settings-option" type="button" id="alert-snooze-10">+10 min</button><button class="settings-option" type="button" id="alert-snooze-60">+1 h</button><button class="settings-option" type="button" id="alert-snooze-1440">Mañana</button></div></div>"`;
