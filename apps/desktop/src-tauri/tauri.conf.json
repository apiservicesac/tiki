{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiki",
  "version": "0.2.2-rc.2",
  "identifier": "pe.apiservice.tiki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "Tiki",
        "url": "index.html",
        "width": 700,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Tus tickets, tareas y recordatorios en una isla arriba de la pantalla.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBMTQwQTFFQTQwQzZCQzkKUldUSmF3eWtIZ29VbXM1S2lGQXJpdnNmaGhuOFJWRnY0aTlkdjBwTHcxY2tDclNkMjVZRnNYK2sK",
      "endpoints": [
        "https://raw.githubusercontent.com/apiservicesac/tiki/main/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
